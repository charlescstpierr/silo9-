+def require_bound_target(shot, position, ident):
+    require(vector(position), 'primary target pose absent')
+    offset = {'crate': .4125, 'sentinel_1': .9, 'arc': .6}[ident]
+    require(close_vector(shot['target_position'], [position[0], position[1]+offset, position[2]]), 'shot collider differs from primary pose')
+    if ident != 'sentinel_1':
+        expected = [.825, .4125, .75] if ident == 'crate' else [.4, .6, .225]
+        require(close_vector(shot['target_half_size'], expected), 'shot collider differs from primary shape')
+    else:
+        half = shot['target_half_size']
+        require(abs(half[1]-.9) < .01 and all(.39 <= half[i] <= .58 for i in [0, 2]), 'sentinel collision geometry mismatch')
+
+
+def validate_snapshot_types(snapshot):
+    require(type(snapshot) is dict and set(snapshot) == SAVE_KEYS, 'save snapshot field mismatch')
+    for key in ['schema', 'ammo', 'reserve', 'components', 'medkits', 'cells', 'phase']:
+        require(number(snapshot[key]) and float(snapshot[key]).is_integer(), 'snapshot integer type: ' + key)
+    for key in ['health', 'energy', 'elapsed', 'player_yaw']:
+        require(number(snapshot[key]), 'snapshot numeric type: ' + key)
+    for key in ['upgraded', 'crate_broken']:
+        require(type(snapshot[key]) is bool, 'snapshot boolean type: ' + key)
+    require(type(snapshot['ending']) is str and vector(snapshot['player_position']), 'snapshot string/position type')
+    for key in ['collected', 'defeated', 'facts', 'memory']:
+        require(type(snapshot[key]) is list and all(type(x) is str for x in snapshot[key]), 'snapshot collection type: ' + key)
+    keys(snapshot['circuits'], 'maintenance archives')
+    require(all(type(v) is bool for v in snapshot['circuits'].values()), 'snapshot circuit type')
+    keys(snapshot['relations'], 'mother n7')
+    require(all(number(v) and float(v).is_integer() for v in snapshot['relations'].values()), 'snapshot relation type')
+    require(type(snapshot['death_poses']) is dict and set(snapshot['death_poses']) <= ROBOT_IDS, 'snapshot death IDs')
+    for pose in snapshot['death_poses'].values():
+        keys(pose, 'position yaw')
+        require(vector(pose['position']) and number(pose['yaw']), 'snapshot death pose type')
+
+
+def snapshot_after_vector_decode(saved):
+    # State reconstructs only these positions as Godot Vector3 (float32).
+    # Other fields remain exact; elapsed legitimately advances after loading.
+    result = {k:v for k,v in saved.items() if k != 'elapsed'}
+    def vec32(value):
+        require(vector(value), 'invalid saved Vector3')
+        return [struct.unpack('f', struct.pack('f', x))[0] for x in value]
+    result['player_position'] = vec32(saved['player_position'])
+    result['death_poses'] = {ident: dict(pose, position=vec32(pose['position'])) for ident, pose in saved['death_poses'].items()}
+    return result
 
 
