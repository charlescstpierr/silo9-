extends SceneTree
const State = preload("res://scripts/run_state.gd")
var failures: int = 0

func check(value: bool, label: String) -> void:
	if not value:
		failures += 1
		printerr("FAIL: " + label)

func _initialize() -> void:
	var state := State.new()
	check(state.spend_energy(20.0), "scanner can spend energy")
	check(state.energy == 80.0, "energy debit is exact")
	check(not state.spend_energy(-10.0), "negative spend rejected")
	check(not state.spend_energy(INF), "infinite spend rejected")
	check(state.discover_relay(), "scan permanently discovers relay")
	check(state.phase == 1, "scan advances mission")
	check(not state.repair_relay(), "repair requires components")
	check(state.collect("parts-a", "components", 7), "collect finite salvage")
	check(not state.collect("parts-a", "components", 7), "duplicate loot rejected")
	check(not state.collect("fake", "components", -1), "negative loot rejected")
	check(not state.collect("fake", "unknown", 1), "unknown loot rejected")
	check(state.upgrade(), "battery upgrade requires salvage")
	check(state.components == 4 and state.max_energy() == 150.0, "upgrade cost and capacity")
	check(not state.upgrade(), "upgrade only once")
	state.spend_energy(state.energy)
	state.recharge()
	check(state.energy == 150.0, "lift prevents scanner softlock")
	check(state.repair_relay(), "repair after scanner and salvage")
	check(state.components == 1 and state.phase == 2, "repair consumes three parts")
	check(not state.choose_ending("mother"), "ending requires core")
	check(state.recover_core(), "core accessible after power")
	check(not state.choose_ending("invented"), "closed ending choices")
	check(state.choose_ending("n7") and state.phase == 4, "N7 ending completes mission")
	check(not state.choose_ending("mother"), "ending cannot be changed")
	state.damage(35.0)
	check(state.health == 65.0, "damage applied")
	state.damage(-100.0)
	check(state.health == 65.0, "negative damage rejected")
	check(state.heal() and state.medkits == 1 and state.health == 100.0, "healing consumes medkit")
	check(not state.heal() and state.medkits == 1, "no medkit waste at full health")
	state.spend_energy(100.0)
	check(state.use_cell() and state.cells == 1 and state.energy == 110.0, "cell recharges 60")
	check(state.fire_round() and state.ammo == 11, "pistol spends round")
	check(state.reload_rounds() == 1 and state.reserve == 47 and state.ammo == 12, "reload conserves ammunition")
	state.mark_defeated("sentinel-a")
	state.mark_defeated("sentinel-a")
	check(state.defeated.size() == 1, "defeat persisted once")
	for i in range(80):
		state.remember("event-" + str(i))
	check(state.memory.size() <= 32 and state.memory.has("event-79"), "memory bounded and recent")
	state.add_fact("arc_lock_disabled")
	check(state.facts.has("arc_lock_disabled"), "ARC bypass has persistent world state")
	check(state.change_trust("mother", 1) and state.relations.mother == 1, "trust changes authoritative relationship")
	check(not state.change_trust("mother", 99) and not state.change_trust("invented", 1), "trust input bounded")
	for i in range(10):
		state.change_trust("n7", -1)
	check(state.relations.n7 == -5, "relationship score saturates at boundary")
	var save_path := "user://state-test.json"
	check(state.save_game(save_path) == OK, "atomic save succeeds")
	var restored := State.new()
	check(restored.load_game(save_path) == OK, "save loads")
	check(restored.ending == "n7" and restored.upgraded and restored.reserve == 47 and restored.relations.mother == 1 and restored.relations.n7 == -5, "save restores progression and inventory")
	var file := FileAccess.open(save_path, FileAccess.READ)
	var valid: Dictionary = JSON.parse_string(file.get_as_text())
	file.close()
	for mutation in [{"energy": -1}, {"phase": 2, "ending": "n7"}, {"ammo": 13}, {"health": "100"}, {"player_position": [0, 0]}, {"collected": ["same", "same"]}, {"phase": 0, "ending": ""}]:
		var bad: Dictionary = valid.duplicate(true)
		bad.merge(mutation, true)
		file = FileAccess.open(save_path, FileAccess.WRITE)
		file.store_string(JSON.stringify(bad))
		file.close()
		check(restored.load_game(save_path) != OK, "reject corrupt state " + str(mutation))
		check(restored.ending == "n7" and restored.reserve == 47, "failed load is atomic")
	var mother := State.new()
	mother.discover_relay()
	mother.collect("parts", "components", 3)
	mother.repair_relay()
	mother.recover_core()
	check(mother.choose_ending("mother"), "MERE ending available")
	DirAccess.remove_absolute(save_path)
	print("State checks failures: ", failures)
	quit(1 if failures else 0)
